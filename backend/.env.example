# Server Configuration
PORT=5000

# Database Configuration (PostgreSQL)
# In Docker Compose, DB_HOST matches the service name 'db'
DB_HOST=db
DB_PORT=5432
DB_NAME=taskdb
DB_USER=postgres
DB_PASSWORD=postgres_secure_password

# CORS Configuration
# Set to frontend origin, or leave blank to allow all in development
CORS_ORIGIN=http://localhost:3000
