# ==============================================================================
# Task Management Web Application - Global Environment Configuration Template
# NOTE: DO NOT commit actual secrets or production passwords to source control.
# Copy this file to .env for local Docker Compose runs.
# ==============================================================================

# Backend Port (Container & Host)
PORT=5000

# PostgreSQL Database Configuration
DB_HOST=db
DB_PORT=5432
DB_NAME=taskdb
DB_USER=postgres
DB_PASSWORD=your_strong_postgres_password_here

# Backend CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# Frontend REST API Base URL (consumed by React at build/runtime)
VITE_API_URL=http://localhost:5000
